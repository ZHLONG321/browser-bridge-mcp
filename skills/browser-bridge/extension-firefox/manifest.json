{
  "manifest_version": 2,
  "name": "Firefox Browser Bridge",
  "version": "1.3.0",
  "description": "Native Firefox WebExtension API bridge for the local Browser Bridge service.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-browser-bridge@browser-bridge.local"
    }
  },
  "background": {
    "scripts": [
      "socket-client.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Firefox Browser Bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "<all_urls>",
    "activeTab",
    "alarms",
    "bookmarks",
    "browserSettings",
    "captivePortal",
    "clipboardRead",
    "clipboardWrite",
    "contextualIdentities",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "dns",
    "downloads",
    "downloads.open",
    "find",
    "geolocation",
    "history",
    "identity",
    "idle",
    "management",
    "menus",
    "menus.overrideContext",
    "nativeMessaging",
    "notifications",
    "pkcs11",
    "privacy",
    "proxy",
    "scripting",
    "search",
    "sessions",
    "storage",
    "tabGroups",
    "tabHide",
    "tabs",
    "theme",
    "topSites",
    "unlimitedStorage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "webRequestFilterResponse.serviceWorkerScript"
  ],
  "user_scripts": {},
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'; connect-src http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
  "incognito": "spanning"
}
